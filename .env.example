# Server-side Supabase source of truth (never expose the service-role key to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets server-only settings. Store JSON as one line in ignored local/Vercel secrets; never use NEXT_PUBLIC_*.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Telegram live delivery is deliberately opt-in.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LIVE_ENABLED=false

# Optional public links displayed in the website once configured.
NEXT_PUBLIC_TELEGRAM_BOT_URL=
NEXT_PUBLIC_GOOGLE_SHEETS_URL=
NEXT_PUBLIC_GITHUB_REPOSITORY_URL=
